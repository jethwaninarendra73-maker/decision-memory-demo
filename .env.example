# Copy to .env (git-ignored). Every value is optional; the app runs with none of them.

# offline (default) | anthropic. "anthropic" only takes effect when a key is also set.
LLM_MODE=offline

# Optional, Stage 12 only. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional model for the Anthropic mode (default claude-opus-5-5).
DM_LLM_MODEL=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
DM_LOG_LEVEL=INFO

# SQLite file, relative to the repo root.
DM_DB_PATH=data/demo.db

# Hosted demos only (see docs/DEPLOY.md). Leave empty on your laptop.
# true: every visitor gets their own fresh copy of the demo data.
DM_PER_SESSION_DB=
# A shared password asked for before the app is shown. Set it in the host's secrets,
# never in a file that is committed.
DM_ACCESS_PASSWORD=
